digraph DER {
  graph [rankdir=LR, splines=spline, nodesep=0.55, ranksep=1.0, bgcolor="white", pad=0.3, fontname="Liberation Sans"];
  node  [shape=plain, fontname="Liberation Sans", fontsize=12];
  edge  [fontname="Liberation Sans", fontsize=11, color="#444444", dir=both, arrowtail=teetee, arrowhead=crowodot, penwidth=1.4];
  USUARIO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#4A148C"><FONT COLOR="white"><B>USUARIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">nome</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">cargo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">senha_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">perfil_acesso</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">tentativas_login</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">bloqueado_ate</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">criado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DATETIME</FONT></TD></TR></TABLE>>];
  ATIVO_CRITICO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#1565C0"><FONT COLOR="white"><B>ATIVO_CRITICO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT"><B>id_ativo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">UQ</FONT></TD><TD ALIGN="LEFT">nome_sistema</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">criticidade</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">responsavel</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">descricao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">rto_meta_min</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">rpo_meta_min</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">criado_em</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DATETIME</FONT></TD></TR></TABLE>>];
  JOB_BACKUP [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#1A3A6B"><FONT COLOR="white"><B>JOB_BACKUP</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT"><B>id_job</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT"><B>id_ativo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">data_execucao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">tipo_backup</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">tamanho_gb</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DECIMAL(10,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">duracao_min</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">destino</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">VARCHAR(100)</FONT></TD></TR></TABLE>>];
  FALHA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#B71C1C"><FONT COLOR="white"><B>FALHA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT"><B>id_falha</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT"><B>id_job</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">data_registro</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">descricao_erro</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">causa_raiz</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">encaminhamento</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">solucao_aplicada</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">status_resolucao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">data_resolucao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DATETIME</FONT></TD></TR></TABLE>>];
  RESTAURACAO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#1B5E20"><FONT COLOR="white"><B>RESTAURACAO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT"><B>id_restauracao</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT"><B>id_job</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">data_solicitacao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">data_conclusao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">motivo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">rto_realizado_min</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">resultado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">ENUM</FONT></TD></TR></TABLE>>];
  LOG_AUDITORIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#888888"><TR><TD COLSPAN="3" BGCOLOR="#006064"><FONT COLOR="white"><B>LOG_AUDITORIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT"><B>id_log</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT"><B>id_usuario</B></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">tabela_afetada</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">acao</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">id_registro</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="26"><FONT COLOR="#555555" POINT-SIZE="10">&nbsp;&nbsp;</FONT></TD><TD ALIGN="LEFT">data_hora</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="10">DATETIME</FONT></TD></TR></TABLE>>];
  ATIVO_CRITICO -> JOB_BACKUP [label=" gera "];
  JOB_BACKUP -> FALHA [label=" origina "];
  JOB_BACKUP -> RESTAURACAO [label=" permite "];
  FALHA -> USUARIO [label=" registra ", dir=both, arrowhead=teetee, arrowtail=crowodot];
  RESTAURACAO -> USUARIO [label=" solicita ", dir=both, arrowhead=teetee, arrowtail=crowodot];
  USUARIO -> LOG_AUDITORIA [label=" origina "];
  { rank=same; USUARIO; LOG_AUDITORIA; }
}